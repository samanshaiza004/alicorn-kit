---
interface Props {
  href: string;
  title: string;
  packageName: string;
  purpose: string;
  badges?: string[];
}
const { href, title, packageName, purpose, badges = [] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const target = href.startsWith('http')
  ? href
  : `${base.replace(/\/$/, '')}/${href.replace(/^\//, '')}`;
---
<a class="component-card" href={target}>
  <code>{packageName}</code>
  <h3>{title}</h3>
  <p>{purpose}</p>
  <div class="card-meta">
    {badges.map((badge) => <span class="badge">{badge}</span>)}
  </div>
</a>
